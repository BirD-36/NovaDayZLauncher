<Window x:Class="NovaDayZ.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDayZ Admin" Height="720" Width="1080" Background="#14091F">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Загрузить config.json" Click="LoadClick" Margin="0,0,8,0"/>
            <Button Content="Сохранить config.json" Click="SaveClick" Margin="0,0,8,0"/>
            <Button Content="Zip -> SHA256" Click="HashClick" Margin="0,0,8,0"/>
            <Button Content="ОПУБЛИКОВАТЬ (FTP)" Click="PublishClick" Background="#7C3AED" Foreground="White"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Servers}" AutoGenerateColumns="False" CanUserAddRows="True" Background="#241436" Foreground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140"/>
                <DataGridTextColumn Header="GamePort" Binding="{Binding GamePort}" Width="70"/>
                <DataGridTextColumn Header="QueryPort" Binding="{Binding QueryPort}" Width="70"/>
                <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="90"/>
                <DataGridTextColumn Header="Thumb" Binding="{Binding Thumb}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Версия" Foreground="#B9A8D9"/>
                <TextBox x:Name="VersionBox" Text="1.0.0"/>
                <TextBlock Text="Update URL" Foreground="#B9A8D9" Margin="0,6,0,0"/>
                <TextBox x:Name="UpdateUrlBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0">
                <TextBlock Text="SHA256" Foreground="#B9A8D9"/>
                <TextBox x:Name="ShaBox"/>
                <TextBlock Text="Release notes" Foreground="#B9A8D9" Margin="0,6,0,0"/>
                <TextBox x:Name="NotesBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="FTP: host / user / pass" Foreground="#B9A8D9"/>
                <TextBox x:Name="FtpHostBox"/>
                <TextBox x:Name="FtpUserBox"/>
                <PasswordBox x:Name="FtpPassBox"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>