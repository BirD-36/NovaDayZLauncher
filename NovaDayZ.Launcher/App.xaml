<Application x:Class="NovaDayZ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="NovaBackground" Color="#14091F"/>
            <SolidColorBrush x:Key="NovaPanel" Color="#241436"/>
            <SolidColorBrush x:Key="NovaText" Color="#F5EFFF"/>
            <SolidColorBrush x:Key="NovaTextSecondary" Color="#B9A8D9"/>
            <SolidColorBrush x:Key="NovaNeon" Color="#D946EF"/>
            <LinearGradientBrush x:Key="NovaGradient" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#7C3AED" Offset="0"/>
                <GradientStop Color="#EC4899" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>