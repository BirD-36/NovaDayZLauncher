<Window x:Class="NovaDayZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDayZ Launcher" Height="780" Width="1280"
        Background="{StaticResource NovaBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0D0613" Padding="20,40,20,20">
            <StackPanel>
                <TextBlock Text="NOVA" FontSize="28" FontWeight="Bold" Foreground="{StaticResource NovaNeon}"/>
                <TextBlock Text="DAYZ" FontSize="28" FontWeight="Bold" Foreground="{StaticResource NovaText}" Margin="0,-6,0,30"/>
                <Button Content="▶ ИГРАТЬ" Click="OnServersClick" Background="{StaticResource NovaGradient}" Foreground="White" FontWeight="Bold" Padding="14" Margin="0,0,0,8"/>
                <Button Content="Серверы" Click="OnServersClick" Background="Transparent" Foreground="{StaticResource NovaText}" HorizontalContentAlignment="Left" Padding="10" Margin="0,0,0,4"/>
                <Button Content="Моды" Click="OnModsClick" Background="Transparent" Foreground="{StaticResource NovaTextSecondary}" HorizontalContentAlignment="Left" Padding="10" Margin="0,0,0,4"/>
                <Button Content="Новости" Background="Transparent" Foreground="{StaticResource NovaTextSecondary}" HorizontalContentAlignment="Left" Padding="10" Margin="0,0,0,4"/>
                <Button Content="Настройки" Click="OnSettingsClick" Background="Transparent" Foreground="{StaticResource NovaTextSecondary}" HorizontalContentAlignment="Left" Padding="10"/>
                <TextBlock x:Name="VersionLabel" Text="v1.0.0" Foreground="#666" Margin="0,30,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Margin="30,30,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Список серверов NovaDayZ" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NovaText}"/>
            <TextBlock Grid.Row="0" Text="Автообновление модов включено" Foreground="{StaticResource NovaTextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,4" HorizontalAlignment="Right"/>

            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ServersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource NovaPanel}" CornerRadius="12" Padding="22,16" Margin="0,0,0,14" BorderBrush="#55D946EF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Название, карта, IP -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NovaText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#1A0F2B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Map}" Foreground="#EC4899" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Address, StringFormat='IP: {0}'}" Foreground="{StaticResource NovaTextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding GamePort, StringFormat='Port: {0}'}" Foreground="{StaticResource NovaTextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Статус: точка + онлайн/выключен + пинг -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Fill" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Foreground="{StaticResource NovaTextSecondary}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Сервер выключен"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Text">
                                                                <Setter.Value>
                                                                    <MultiBinding StringFormat="{}{0}/{1}">
                                                                        <Binding Path="Players"/>
                                                                        <Binding Path="MaxPlayers"/>
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PingMs, StringFormat=' • {0} ms'}"
                                                   Foreground="{StaticResource NovaTextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Кнопка ИГРАТЬ (блокируется на офлайн) -->
                                    <Button Grid.Column="2" Content="ИГРАТЬ" Click="OnPlayClick"
                                            Background="{StaticResource NovaGradient}" Foreground="White" FontWeight="Bold" FontSize="16"
                                            Padding="34,12" Margin="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1A0F2B" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="Готов к запуску" Foreground="{StaticResource NovaTextSecondary}"/>
            </Border>
        </Grid>
    </Grid>
</Window>